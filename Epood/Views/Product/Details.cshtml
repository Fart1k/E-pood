@model Epood.ViewModels.ProductDetailsViewModel
<link rel="stylesheet" href="~/css/product-details.css"/>
<div class="product-page">

    <div class="product-card">

        <h1 class="product-title">@Model.Name</h1>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @{
            var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var isSeller = Model.SellerId == userId;
        }
        <div class="product-content">

            @if (!(isSeller && Model.IsBidHistoryView))
            {
                <div class="product-image-wrapper">
                    @if (Model.ImageUrls != null && Model.ImageUrls.Any(x => !string.IsNullOrWhiteSpace(x)))
                    {
                        <div class="product-gallery">

                            <div class="main-image">
                                <img src="@Model.ImageUrls.First()" />
                            </div>

                            <div class="thumbnail-row">
                                @foreach (var img in Model.ImageUrls)
                                {
                                    <div class="thumbnail-box">
                                        <img src="@img" />
                                    </div>
                                }
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="no-image">No image</div>
                    }
                </div>
            }
            else
            {
                <div class="bid-history-panel">
                    <h3>Bid History</h3>

                    @foreach (var bid in Model.Bids)
                    {
                        <div class="bid-row">
                            <div><strong>@bid.UserName</strong></div>
                            <div>@bid.Amount €</div>
                            <div>@bid.CreatedAt</div>
                        </div>
                    }
                </div>
            }

            @* <div class="product-image-wrapper">

                @if (Model.ImageUrls != null && Model.ImageUrls.Any(x => !string.IsNullOrWhiteSpace(x)))
                {
                    <div class="product-gallery">

                        <div class="main-image">
                            <img src="@Model.ImageUrls.First()" />
                        </div>

                        <div class="thumbnail-row">
                            @foreach (var img in Model.ImageUrls)
                            {
                                <div class="thumbnail-box">
                                    <img src="@img" />
                                </div>
                            }
                        </div>

                    </div>
                }
                else
                {
                    <div class="no-image">No image</div>
                }

            </div> *@

            <div class="product-info">

                <p class="product-description">@Model.Description</p>

                @if (Model.IsAuction)
                {
                    <div class="auction-info">

                        <p style="font-size: 32px;"><strong>Auction info:</strong></p>

                        <p>Starting price: <span style="float: right;">@Model.MinPrice €</span> </p>

                        <p>Current price: <span style="float: right;">@Model.CurrentPrice €</span> </p>

                        <p>Ends at: <span style="float: right;">@Model.AuctionEndTime</span> </p>

                        @if (Model.SellerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@Model.Id"
                               asp-route-view="history"
                               asp-route-productId="@Model.Id"
                               class="bid-history-btn">
                                Bid History
                            </a>
                        }
                        else
                        {
                            <form asp-controller="Bid" asp-action="PlaceBid" method="post">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="number" name="amount" step="0.01" placeholder="Your bid" />
                                <button type="submit">Make Bid</button>
                            </form>

                            <form asp-controller="Bid" asp-action="EnableAutoBid" method="post">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="number" name="maxAmount" placeholder="Max auto bid" />
                                <button type="submit">Enable Auto Bid</button>
                            </form>
                        }

                    </div>
                }
                else
                {
                    <div class="buy-info">

                        <p><strong>Price:</strong> @Model.Price €</p>

                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <button type="submit">Add to cart</button>
                        </form>

                    </div>
                }

            </div>

        </div>

    </div>

</div>