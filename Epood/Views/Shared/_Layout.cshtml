@using Microsoft.AspNetCore.Identity
@inject SignInManager<Epood.Models.ApplicationUser> signInManager;


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Turuputka</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Epood.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Judson:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/navbar.css"/>
</head>
<body>

    <header class="shared-layout-27">

        <div class="nav-left">
            <a class="brand" asp-controller="Home" asp-action="Index">
                Turuputka
            </a>
        </div>

        <div class="nav-center">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Auctions">Auctions</a>
            @if (signInManager.IsSignedIn(User) && User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="PendingProducts">
                    Pending Products
                </a>
            }
        </div>

        <div class="nav-right">

            @if (signInManager.IsSignedIn(User))
            {
                <div class="dropdown">
                    <button class="dropdown-toggle" type="button">
                        My Account
                    </button>

                    <div class="dropdown-menu-custom">
                        <a asp-controller="Account" asp-action="Index">Profile</a>
                        <a asp-controller="Account" asp-action="Settings">Settings</a>
                        <a asp-controller="Cart" asp-action="Index">My Cart</a>

                        <form method="post" asp-controller="Auth" asp-action="Logout">
                            <button type="submit">Logout</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login">Login</a>
                <a asp-controller="Auth" asp-action="Register">Sign Up</a>
            }

        </div>

    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
